{
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph.cmd prompt-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/donde-quede.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/respaldo-config.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "codex@openai-codex": true,
    "vercel@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "accesslint@accesslint": true,
    "browse@browserbase": true,
    "functions@browserbase": true,
    "browser-trace@browserbase": true,
    "safe-browser@browserbase": true,
    "webmcp-gen@browserbase": true,
    "add-webmcp@browserbase": true,
    "hyperframes@hyperframes": true,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "flightdeck@claude-flightdeck": true,
    "md-preview@claude-code-mods": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "accesslint": {
      "source": {
        "source": "github",
        "repo": "AccessLint/skills"
      }
    },
    "browserbase": {
      "source": {
        "source": "github",
        "repo": "browserbase/skills"
      }
    },
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    },
    "claude-flightdeck": {
      "source": {
        "source": "github",
        "repo": "scasella/claude-flightdeck"
      }
    },
    "pinboard": {
      "source": {
        "source": "github",
        "repo": "sirkitree/pinboard"
      }
    },
    "claude-code-mods": {
      "source": {
        "source": "github",
        "repo": "hamzafer/claude-code-mods"
      }
    }
  },
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
